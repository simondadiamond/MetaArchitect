@@ -0,0 +1,72 @@
+export type RemembersItem = { label: string; value: string };
+
+/**
+ * ResetVsRemembers — twin physical note cards contrasting a chat that starts
+ * over every time against a workspace that persists. Salvaged from the closed
+ * Draftsman/paper rollout's `NoteCard.tsx` (PR #106) and re-tokened for dark
+ * surfaces: `bg-background-elevated` in place of paper's lifted-card tone,
+ * a real dark box-shadow, the torn-tape accent. Cards render level — Simon
+ * flagged the paper build's whole-card off-axis rotation twice (2026-08-09
+ * on paper, again 2026-08-10 after it carried over into this salvage) — the
+ * tape's own small tilt stays as the only rotation cue.
+ * Illustrates "the tool remembers your business" without a fake terminal —
+ * comprehension-first per brand/visual-operator.md: both cards carry an
+ * explicit label, nothing here needs to be decoded.
+ */
+export default function ResetVsRemembers({
+  resetLabel,
+  resetLine,
+  resetRepeat,
+  remembersLabel,
+  remembersItems,
+}: {
+  resetLabel: string;
+  resetLine: string;
+  resetRepeat: string;
+  remembersLabel: string;
+  remembersItems: RemembersItem[];
+}) {
+  const tape = (
+    <span
+      aria-hidden="true"
+      className="absolute -top-2.5 left-1/2 -ml-7 h-5 w-14 bg-background-surface/80 border border-border rotate-[-2deg]"
+    />
+  );
+
+  return (
+    <div className="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-6 max-w-2xl">
+      {/* Card A — resets */}
+      <div className="op-radius relative bg-background-elevated border border-border shadow-[0_10px_26px_rgba(0,0,0,0.4)] p-6 pt-8">
+        {tape}
+        <p className="text-[11px] tracking-[0.12em] uppercase text-text-muted mb-4">
+          {resetLabel}
+        </p>
+        <p className="font-serif italic text-[15px] leading-snug text-text-secondary mb-2">
+          &ldquo;{resetLine}&rdquo;
+        </p>
+        <p className="font-serif italic text-[15px] leading-snug text-text-muted/60">
+          &ldquo;{resetLine}&rdquo;
+        </p>
+        <p className="text-[12px] text-text-muted mt-4">{resetRepeat}</p>
+      </div>
+
+      {/* Card B — remembers */}
+      <div className="op-radius relative bg-background-elevated border border-border border-t-2 border-t-accent shadow-[0_10px_26px_rgba(0,0,0,0.4)] p-6 pt-8">
+        {tape}
+        <p className="text-[11px] tracking-[0.12em] uppercase text-accent-link mb-4">
+          {remembersLabel}
+        </p>
+        <ul className="flex flex-col gap-2.5">
+          {remembersItems.map((item) => (
+            <li key={item.label} className="flex items-baseline justify-between gap-3">
+              <span className="text-[13px] font-medium text-text-primary shrink-0">
+                {item.label}
+              </span>
+              <span className="text-[13px] text-text-secondary text-right">{item.value}</span>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+}
