new file mode 100644
index 0000000..bcd894d
--- /dev/null
+++ b/components/operator/PricingSheet.tsx
@@ -0,0 +1,125 @@
+import { Link } from "@/i18n/navigation";
+import FoundingSeal from "./FoundingSeal";
+
+export type PricingSheetRow = {
+  num: string;
+  name: string;
+  price: string;
+  label?: string;
+  period?: string;
+  description?: string;
+  includes?: string[];
+  founding?: string;
+  sealed?: boolean;
+  sealLabel?: string;
+  sealCount?: string;
+  href?: string;
+  detailsCta?: string;
+};
+
+/**
+ * PricingSheet — the rate card as a lifted physical sheet: numbered rows on a
+ * dotted leader line ("01  Working Session ······ $125/hr") instead of a
+ * bordered box grid. Salvaged from the closed Draftsman/paper rollout's
+ * `SpecSheet.tsx` (PR #106) and re-tokened for dark surfaces — same structure,
+ * `--color-accent-link` (amber) in place of paper's brass, `bg-background-
+ * elevated` in place of paper's lifted-sheet tone. One shared component used
+ * identically on the homepage ladder, /setup's full pricing table, and (in
+ * lighter form) /work-with-me's progression list — the cross-page consistency
+ * this refresh exists to fix.
+ */
+export default function PricingSheet({
+  rows,
+  footnote,
+}: {
+  rows: PricingSheetRow[];
+  footnote?: string;
+}) {
+  return (
+    <div className="op-radius relative bg-background-elevated border border-border shadow-[0_8px_28px_rgba(0,0,0,0.35)] p-6 md:p-10">
+      <span
+        aria-hidden="true"
+        className="absolute top-5 left-5 h-1.5 w-1.5 rounded-full bg-text-muted/50"
+      />
+      <ul className="list-none m-0 p-0 divide-y divide-border">
+        {rows.map((r) => {
+          const row = (
+            <>
+              {r.label && (
+                <p className="text-[11px] tracking-[0.14em] uppercase text-text-muted mb-2">
+                  {r.label}
+                </p>
+              )}
+              <div className="flex items-baseline gap-3 flex-wrap">
+                <span className="text-accent-link text-[13px] font-medium tabular-nums shrink-0">
+                  {r.num}
+                </span>
+                <span className="font-serif text-lg text-text-primary">{r.name}</span>
+                <span
+                  aria-hidden="true"
+                  className="flex-1 min-w-[24px] border-b border-dotted border-border translate-y-[-4px]"
+                />
+                <span className="font-serif text-lg text-text-primary whitespace-nowrap tabular-nums">
+                  {r.price}
+                </span>
+                {r.sealed && (
+                  <FoundingSeal
+                    label={r.sealLabel ?? "Founding rate"}
+                    count={r.sealCount ?? "3 of 3"}
+                  />
+                )}
+              </div>
+              {r.period && (
+                <p className="mt-1 ml-0 text-[12px] tracking-wide text-text-muted">{r.period}</p>
+              )}
+              {r.description && (
+                <p className="mt-2 text-[14px] leading-body text-text-secondary max-w-[60ch]">
+                  {r.description}
+                </p>
+              )}
+              {r.includes && r.includes.length > 0 && (
+                <ul className="mt-3 flex flex-col gap-2">
+                  {r.includes.map((inc) => (
+                    <li key={inc} className="flex gap-2.5 items-baseline">
+                      <span className="text-accent text-[12px] shrink-0" aria-hidden="true">
+                        +
+                      </span>
+                      <span className="text-[13px] leading-body text-text-secondary">{inc}</span>
+                    </li>
+                  ))}
+                </ul>
+              )}
+              {r.founding && (
+                <p className="mt-3 text-[13px] leading-body text-text-secondary border-t border-border/60 pt-3">
+                  {r.founding}
+                </p>
+              )}
+              {r.href && (
+                <span className="mt-3 inline-block text-[12px] tracking-[0.08em] uppercase text-accent-link">
+                  {r.detailsCta ?? "Details"} <span aria-hidden="true">→</span>
+                </span>
+              )}
+            </>
+          );
+
+          return (
+            <li key={r.num} className="py-5 first:pt-0 last:pb-0">
+              {r.href ? (
+                <Link href={r.href} className="block no-underline op-transition hover:opacity-90">
+                  {row}
+                </Link>
+              ) : (
+                row
+              )}
+            </li>
+          );
+        })}
+      </ul>
+      {footnote && (
+        <p className="mt-6 text-[12px] leading-[1.6] text-text-muted border-t border-border pt-5">
+          {footnote}
+        </p>
+      )}
+    </div>
+  );
+}
