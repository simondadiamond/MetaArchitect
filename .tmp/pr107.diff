+/**
+ * SignatureLine — a quiet line attributing the work to Simon by name, placed
+ * near a page's final CTA. Salvaged from the closed Draftsman/paper rollout
+ * (independent trust-criteria research found the operator buyer responds to
+ * a named human over company polish — docs/research/operator-trust-criteria-
+ * independent-2026-08-09.md). Deliberately plain: no photo, no signature-
+ * font flourish (that would read as a gimmick, not a person).
+ */
+export default function SignatureLine({ children }: { children: React.ReactNode }) {
+  return (
+    <p className="font-serif italic text-[14px] text-text-secondary mt-6">
+      {children}
+    </p>
+  );
+}
