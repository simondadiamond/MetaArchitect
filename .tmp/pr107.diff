new file mode 100644
index 0000000..27f02cf
--- /dev/null
+++ b/components/operator/FoundingSeal.tsx
@@ -0,0 +1,58 @@
+"use client";
+
+import { useId } from "react";
+
+/**
+ * FoundingSeal — dark-toned ink-stamp device marking a founding-rate tier.
+ * Salvaged from the closed Draftsman/paper rollout's `InkSeal.tsx` (PR #106,
+ * branch `draftsman-rollout`) and re-tokened for the dark palette: stroke/text
+ * use `--color-accent-link` (amber, #C97A1A — already the site's validated
+ * dark-background accent) instead of paper's `--color-brass` (#8C6A2F), which
+ * measured ~4.30:1 on paper and failed WCAG AA. Amber on the dark surfaces
+ * this renders against clears AA comfortably.
+ *
+ * A page can render more than one seal (e.g. the ladder row + the founding-
+ * exchange panel) — useId() keeps each instance's textPath id unique and
+ * hydration-safe (the paper build hit a duplicate-id bug from a hardcoded id
+ * before this fix; applying the lesson directly here rather than repeating it).
+ */
+export default function FoundingSeal({
+  label,
+  count,
+  className = "",
+}: {
+  label: string;
+  count: string;
+  className?: string;
+}) {
+  const rimId = useId();
+  const text = `${label} · ${count} · `.toUpperCase();
+  return (
+    <svg
+      viewBox="0 0 96 96"
+      className={`h-16 w-16 shrink-0 rotate-[-8deg] opacity-90 ${className}`}
+      role="img"
+      aria-label={`${label}: ${count}`}
+    >
+      <circle cx="48" cy="48" r="45" fill="none" stroke="#C97A1A" strokeWidth="1.5" />
+      <circle cx="48" cy="48" r="30" fill="none" stroke="#C97A1A" strokeWidth="1" />
+      <defs>
+        <path id={rimId} d="M 48,48 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" />
+      </defs>
+      <text fill="#C97A1A" fontSize="8.5" letterSpacing="1.5" fontFamily="var(--font-inter)">
+        <textPath href={`#${rimId}`}>{text.repeat(2)}</textPath>
+      </text>
+      <text
+        x="48"
+        y="52"
+        textAnchor="middle"
+        fill="#C97A1A"
+        fontSize="11"
+        fontFamily="var(--font-merriweather)"
+        fontStyle="italic"
+      >
+        {count}
+      </text>
+    </svg>
+  );
+}
